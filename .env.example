# KATO Environment Configuration
# Copy this file to .env and modify as needed:  cp .env.example .env
#
# This file has two audiences:
#   1. `make run` / any non-Docker run -- kato/env_loader.py loads it into the
#      process environment before configuration is read.
#   2. docker compose -- reads the same file for ${VAR} substitution only.
#      Variables under "Host run configuration" below are set explicitly on the
#      kato service in docker-compose.yml, so changing them here has no effect
#      on a containerized run.
#
# Precedence: exported shell variables > this file > code defaults.
# Note: values are ${VAR}-interpolated when loaded; escape a literal '$' as '$$'.

# ---------------------------------------------------------------------------
# Host run configuration (non-Docker)
# These are the same names docker-compose passes into the kato service.
# The defaults below point at the ports ./start.sh publishes on localhost.
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=kato

# Redis is DISABLED by default in code. A host run needs both of these, or
# sessions and pattern metadata silently degrade.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

LOG_LEVEL=INFO
SESSION_TTL=3600
SESSION_AUTO_EXTEND=true

# SERVICE_NAME=kato
#   WARNING: SERVICE_NAME is appended to every processor ID, and processor IDs
#   become ClickHouse kb_id partitions and Qdrant collection names. Changing it
#   makes existing learned patterns unreachable. Leave it at 'kato' unless you
#   are deliberately migrating.

# ---------------------------------------------------------------------------
# Docker Compose only
# Consumed by compose for ${VAR} substitution; never read by KATO itself.
# ---------------------------------------------------------------------------
# Enables Redis RDB+AOF persistence so data survives a restart.
# Note: persistence does NOT protect against deletion (e.g. FLUSHALL).
REDIS_PERSISTENCE=true

# ---------------------------------------------------------------------------
# Database authentication (optional)
# Generate credentials with: cd deployment && ./kato-manager.sh setup-auth
# ---------------------------------------------------------------------------
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_SECURE=false
# REDIS_PASSWORD=
# REDIS_TLS=false
#
# IMPORTANT: To enable Qdrant auth, you must ALSO use docker-compose.auth.yml:
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up -d
# Setting QDRANT_API_KEY alone is NOT enough - the Qdrant service needs the override.
# QDRANT_API_KEY=
# QDRANT_HTTPS=false
